{
  "entities": {
    "Lesson": {
      "title": "Lesson",
      "description": "A daily educational lesson published on SUMA+ ACADEMY",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Title of the lesson"
        },
        "summary": {
          "type": "string",
          "maxLength": 600,
          "description": "Short overview and teaser"
        },
        "content": {
          "type": "string",
          "maxLength": 30000,
          "description": "Full markdown/rich text lesson content"
        },
        "category": {
          "type": "string",
          "maxLength": 60,
          "description": "Module category e.g. Mentalidad, Marketing, Hábitos, Herramientas, Estrategia"
        },
        "youtubeUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional YouTube video URL or ID"
        },
        "resources": {
          "type": "array",
          "description": "Resource links with title and url"
        },
        "isDaily": {
          "type": "boolean",
          "description": "Whether this lesson is featured as La Lección del Día"
        },
        "publishedAt": {
          "type": "string",
          "maxLength": 100,
          "description": "Publication date string"
        },
        "readTimeMinutes": {
          "type": "number",
          "description": "Estimated read time in minutes"
        },
        "author": {
          "type": "string",
          "maxLength": 100,
          "description": "Instructor or creator display name"
        },
        "authorEmail": {
          "type": "string",
          "maxLength": 128,
          "description": "Email of author"
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the creator"
        },
        "order": {
          "type": "number",
          "description": "Numerical sequence order"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["title", "summary", "content", "category", "isDaily", "authorId"]
    }
  },
  "firestore": {
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Collection of all public daily lessons"
    }
  }
}
